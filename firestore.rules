rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authorization and data validation
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isValidString(str, minLen, maxLen) {
      return str is string && str.size() >= minLen && str.size() <= maxLen;
    }

    // 1. Festivals collection: public read, admin write
    match /festivals/{festivalId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 2. Reviews collection: public read, moderated write
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['festival_id', 'author', 'rating'])
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && isValidString(request.resource.data.author, 2, 80)
                    && (!('comment' in request.resource.data) || isValidString(request.resource.data.comment, 0, 1000));
      allow update, delete: if isAdmin();
    }

    // 3. User festival submissions: public create with validation, admin management
    match /submissions/{submissionId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasAll(['name', 'city', 'province', 'start_date', 'end_date'])
                    && isValidString(request.resource.data.name, 3, 150)
                    && isValidString(request.resource.data.city, 2, 100)
                    && request.resource.data.province in ['PG', 'TR']
                    && request.resource.data.start_date is string
                    && request.resource.data.end_date is string;
      allow update, delete: if isAdmin();
    }
  }
}
